{
  "name": "score-getItemDetail",
  "description": "通过 itemId 获取评分百科对象详情，包含对象基础信息、评分数据、页面资源、顶部组件（如梗列表）以及 Tab 配置。仅支持虎扑 App 内通过 Bridge 请求。",
  "inputSchema": {
    "type": "object",
    "properties": {
      "itemId": {
        "type": "string",
        "description": "评分百科对象 ID，例如 \"382586\"（也可传数字，会按字符串处理）"
      }
    },
    "required": [
      "itemId"
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "code": {
        "type": "number",
        "description": "状态码。200 表示成功，401 表示未登录，404 表示内容不存在，500 表示服务器错误"
      },
      "message": {
        "type": "string",
        "description": "错误提示信息。当 code 不等于 200 时必须用于向用户友好提示"
      },
      "data": {
        "type": "object",
        "description": "成功时返回的数据载荷",
        "properties": {
          "detail": {
            "type": "object",
            "description": "评分对象详情主体",
            "properties": {
              "image": {
                "type": "array",
                "description": "封面图片 URL 列表",
                "items": {
                  "type": "string"
                }
              },
              "imageShape": {
                "type": "string",
                "description": "图片形状，例如 square"
              },
              "imageSize": {
                "type": "string",
                "description": "图片尺寸标识，例如 pics_1x1"
              },
              "minScoreUserCountLimit": {
                "type": "number",
                "description": "展示评分所需的最小打分人数阈值"
              },
              "bizId": {
                "type": "string",
                "description": "业务对象 ID"
              },
              "bizType": {
                "type": "string",
                "description": "业务类型，例如 encycl_item"
              },
              "name": {
                "type": "string",
                "description": "对象名称"
              },
              "infoJson": {
                "type": "object",
                "description": "扩展信息 JSON，值多为字符串数组形式"
              },
              "scorePersonCount": {
                "type": "number",
                "description": "参与打分的人数"
              },
              "commentCount": {
                "type": "number",
                "description": "评论数"
              },
              "summedScorePersonCount": {
                "type": "number",
                "description": "累计打分人数"
              },
              "totalScore": {
                "type": "number",
                "description": "总分值"
              },
              "scoreAvg": {
                "type": "number",
                "description": "平均评分分值"
              },
              "scoreDistribution": {
                "type": "object",
                "description": "评分分布，键为分值，值为对应人数",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "scoreSummaryTrend": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "评分汇总趋势，可能为 null"
              },
              "scoreTabLocate": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "评分 Tab 默认定位，可能为 null"
              },
              "hottestComments": {
                "type": "array",
                "description": "最热评论文本列表",
                "items": {
                  "type": "string"
                }
              },
              "hotCommentModels": {
                "type": "array",
                "description": "热门评论模型列表",
                "items": {
                  "type": "object",
                  "description": "热门评论模型",
                  "properties": {
                    "commentUserId": {
                      "type": "number",
                      "description": "评论用户 ID"
                    },
                    "commentUserHeadImg": {
                      "type": "string",
                      "description": "评论用户头像 URL"
                    },
                    "commentUserName": {
                      "type": "string",
                      "description": "评论用户昵称"
                    },
                    "commentContent": {
                      "type": "string",
                      "description": "评论内容"
                    },
                    "commentId": {
                      "type": "string",
                      "description": "评论 ID"
                    },
                    "subjectId": {
                      "type": "string",
                      "description": "主题/帖子 ID"
                    },
                    "ancillaryContents": {
                      "type": "array",
                      "description": "评论附属内容",
                      "items": {
                        "type": "object"
                      }
                    },
                    "lightCount": {
                      "type": "number",
                      "description": "点亮/点赞数"
                    },
                    "score": {
                      "type": "number",
                      "description": "该评论用户给出的评分"
                    },
                    "parentCommentUserId": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "父评论用户 ID，可能为 null"
                    },
                    "parentCommentUserName": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "父评论用户昵称，可能为 null"
                    },
                    "parentCommentContent": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "父评论内容，可能为 null"
                    },
                    "parentAncillaryContents": {
                      "type": [
                        "array",
                        "null"
                      ],
                      "description": "父评论附属内容，可能为 null"
                    }
                  }
                }
              },
              "userScore": {
                "type": "number",
                "description": "当前登录用户打的分数，未打分为 0"
              },
              "status": {
                "type": "number",
                "description": "状态码"
              },
              "parentBizKeys": {
                "type": "array",
                "description": "父业务标识列表",
                "items": {
                  "type": "string"
                }
              },
              "canScore": {
                "type": "boolean",
                "description": "是否可评分"
              },
              "canComment": {
                "type": "boolean",
                "description": "是否可评论"
              },
              "showScore": {
                "type": "boolean",
                "description": "是否展示评分"
              },
              "exceedThreshold": {
                "type": "boolean",
                "description": "是否已超过评分展示阈值"
              },
              "bgColor": {
                "type": "string",
                "description": "背景色（十六进制）"
              },
              "maskColor": {
                "type": "string",
                "description": "蒙层颜色（十六进制含透明度）"
              },
              "scoreItemAttributes": {
                "type": "object",
                "description": "评分项属性配置"
              },
              "del": {
                "type": "number",
                "description": "是否删除，0 表示未删除"
              },
              "finalStatus": {
                "type": "string",
                "description": "最终审核状态，例如 PASS"
              },
              "scoreItemNodeId": {
                "type": "array",
                "description": "评分项节点 ID 列表",
                "items": {
                  "type": "number"
                }
              },
              "createDt": {
                "type": "string",
                "description": "创建时间（ISO 时间字符串）"
              },
              "uniqueItem": {
                "type": "boolean",
                "description": "是否唯一评分项"
              },
              "ipLocation": {
                "type": "string",
                "description": "IP 归属地"
              },
              "publishTime": {
                "type": "string",
                "description": "发布时间"
              },
              "scoreColorDay": {
                "type": "string",
                "description": "日间模式评分颜色"
              },
              "scoreColorNight": {
                "type": "string",
                "description": "夜间模式评分颜色"
              },
              "scoreValueHighlight": {
                "type": "boolean",
                "description": "评分值是否高亮"
              },
              "relatedModelList": {
                "type": "array",
                "description": "关联模型列表",
                "items": {
                  "type": "object"
                }
              },
              "bindTagThread": {
                "type": "boolean",
                "description": "是否绑定标签帖子"
              },
              "textLink": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "文本链接，可能为 null"
              },
              "itemId": {
                "type": "number",
                "description": "评分百科对象 ID"
              },
              "itemType": {
                "type": "string",
                "description": "对象类型，例如 normal"
              },
              "memeSubjectItem": {
                "type": "array",
                "description": "梗主题关联项",
                "items": {
                  "type": "object"
                }
              },
              "hotStatements": {
                "type": "array",
                "description": "热门短评/观点列表",
                "items": {
                  "type": "object"
                }
              },
              "relatedInfo": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "关联信息，可能为 null"
              }
            }
          },
          "pageResource": {
            "type": "object",
            "description": "页面资源与跳转链接配置",
            "properties": {
              "headerBgColorDay": {
                "type": "string",
                "description": "日间头部背景色"
              },
              "headerBgColorNight": {
                "type": "string",
                "description": "夜间头部背景色"
              },
              "titleColorDay": {
                "type": "string",
                "description": "日间标题颜色"
              },
              "titleColorNight": {
                "type": "string",
                "description": "夜间标题颜色"
              },
              "descColorDay": {
                "type": "string",
                "description": "日间描述颜色"
              },
              "descColorNight": {
                "type": "string",
                "description": "夜间描述颜色"
              },
              "pageCanShare": {
                "type": "boolean",
                "description": "页面是否可分享"
              },
              "commentCanShare": {
                "type": "boolean",
                "description": "评论是否可分享"
              },
              "showSearchButton": {
                "type": "boolean",
                "description": "是否展示搜索按钮"
              },
              "searchSchema": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "搜索页跳转 schema，可能为 null"
              },
              "shareUrl": {
                "type": "string",
                "description": "分享链接"
              },
              "scoreCommunityGuidelinesUrl": {
                "type": "string",
                "description": "评分社区公约链接"
              },
              "commentManagementUrl": {
                "type": "string",
                "description": "评论管理跳转 schema"
              },
              "scoreEditUrl": {
                "type": "string",
                "description": "评分编辑跳转 schema"
              }
            }
          },
          "topComponents": {
            "type": "array",
            "description": "顶部组件列表（如梗列表 MEME_LIST）",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "组件 ID，例如 MEME_LIST_0"
                },
                "name": {
                  "type": "string",
                  "description": "组件名称，例如 梗列表"
                },
                "index": {
                  "type": "number",
                  "description": "组件排序"
                },
                "componentType": {
                  "type": "string",
                  "description": "组件类型，例如 MEME_LIST"
                },
                "config": {
                  "type": "object",
                  "description": "组件配置",
                  "properties": {
                    "params": {
                      "type": "object",
                      "description": "组件请求参数，例如 itemId、pageSize"
                    },
                    "data": {
                      "type": "array",
                      "description": "组件数据列表",
                      "items": {
                        "type": "object",
                        "description": "梗列表中的单条梗对象",
                        "properties": {
                          "itemId": {
                            "type": "number",
                            "description": "梗对象 itemId"
                          },
                          "bizType": {
                            "type": "string",
                            "description": "业务类型，例如 encycl_item"
                          },
                          "bizId": {
                            "type": "string",
                            "description": "业务对象 ID"
                          },
                          "name": {
                            "type": "string",
                            "description": "梗名称"
                          },
                          "desc": {
                            "type": "string",
                            "description": "梗描述文案"
                          },
                          "schema": {
                            "type": "string",
                            "description": "跳转 schema，例如 huputiyu://score/wiki?itemId=..."
                          },
                          "hotCommentModels": {
                            "type": "array",
                            "description": "梗相关热评",
                            "items": {
                              "type": "object"
                            }
                          },
                          "image": {
                            "type": [
                              "array",
                              "null"
                            ],
                            "description": "封面图列表，可能为 null",
                            "items": {
                              "type": "string"
                            }
                          },
                          "videoDetail": {
                            "type": [
                              "object",
                              "null"
                            ],
                            "description": "视频详情，可能为 null"
                          }
                        }
                      }
                    },
                    "hasMore": {
                      "type": "boolean",
                      "description": "是否还有更多"
                    },
                    "moreDetailLink": {
                      "type": "string",
                      "description": "更多详情跳转 schema"
                    },
                    "addButton": {
                      "type": "object",
                      "description": "添加按钮配置",
                      "properties": {
                        "addButtonTitle": {
                          "type": "string",
                          "description": "按钮文案"
                        },
                        "addButtonLink": {
                          "type": "string",
                          "description": "按钮跳转链接"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "tabConfigs": {
            "type": "object",
            "description": "页面 Tab 配置",
            "properties": {
              "showTab": {
                "type": "boolean",
                "description": "是否展示 Tab"
              },
              "defaultTab": {
                "type": "string",
                "description": "默认选中的 Tab ID"
              },
              "tabs": {
                "type": "array",
                "description": "Tab 列表",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "Tab ID"
                    },
                    "name": {
                      "type": "string",
                      "description": "Tab 名称，例如 热议/赛程/资讯/讨论"
                    },
                    "index": {
                      "type": "number",
                      "description": "Tab 排序"
                    },
                    "componentType": {
                      "type": "string",
                      "description": "组件类型，例如 DISCUSS_TAG、MATCH_SCHEDULE、NEWS、TAG_THREAD_LIST"
                    },
                    "config": {
                      "type": "object",
                      "description": "Tab 组件配置与请求参数"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "required": [
      "code",
      "message"
    ]
  }
}