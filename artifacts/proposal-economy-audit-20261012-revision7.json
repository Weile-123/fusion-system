  "policy": {
    "status": "Design only; custom discounts/free purchases are not implemented by the current core",
    "referenceWinRate": 0.6666666666666666,
    "SPrimaryTargetPerBattle": 2,
    "SSRPrimaryTargetPerBattle": 4,
    "freeBasicBoostMaxValue": 5,
    "eligibleFreeBoosts": [
      "hot",
      "paint",
      "stopper"
    ],
    "scope": "仅指定主力槽；每场备战为额度窗口，包含战败后下一场；不按关卡编号重置。首次使用时冻结该身份全部经济类型额度，换槽、换SSR版本、出售重买不再发放。",
    "rules": [
      "战后4与胜利6按2/3胜率参考等值；S胜利3参考值2，胜率0.5/0.8时必须另列敏感性。",
      "优惠按实际操作使用计算，不操作没有收益；不折成自动奖金。",
      "免费强化仅三种基础价5的强化，每窗口全队最多一次，仍受商品售罄及强化购买上限约束；付费价更低时按实际原价估值。",
      "优惠仅覆盖指定操作，球员商店购买及刷新不享受任何天赋折扣；单抽优惠不覆盖十连。",
      "付费操作折扣后价格最低1；装备刷新允许降到0；已有免费刷新优先使用，不消耗减价额度。",
      "同一操作仅选一名球员优惠，取实际节省最高者；不叠加，也不消耗未选中球员的额度。",
      "复活、读档、重新进入商店不能刷新已消费额度；经济日志须进入新规则的服务端重放。"
    ]
  },
